model User {
    id          String @id @default(cuid())

    name        String
    email       String @unique
    username    String @unique
    password    String

    role        Role    @default(USER)

    files       File[]
    posts       Post[]
    lectures    Lecture[]
    
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")
    @@map("users")
}

// Роли участников платформы
enum Role {
    // Пользователь
    USER
    // Учитель
    TEAСHER
    // Администратор
    ADMIN
    // Разработчик
    DEVELOPER
}
